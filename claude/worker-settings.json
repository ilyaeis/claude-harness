{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *+*)",
      "Bash(gh pr merge *)",
      "Bash(git reset *--hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(ssh * rm *)",
      "Bash(ssh * rmdir *)",
      "Bash(ssh * unlink *)",
      "Bash(ssh *-delete*)",
      "Bash(rsync *--delete*)"
    ],
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "NotebookEdit(*)",
      "WebFetch(*)",
      "WebSearch"
    ]
  }
}
