{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 .claude/hooks/check_before_commit.py",
            "timeout": 180,
            "statusMessage": "Running the quality gate before commit"
          }
        ]
      }
    ]
  }
}
